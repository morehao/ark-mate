{
  "name": "@ark-mate/web",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "build:watch": "vite build --watch --no-emptyOutDir"
  },
  "devDependencies": {
    "@ark-mate/console": "workspace:*",
    "@ark-mate/desktop-contract": "workspace:*",
    "@ark-mate/tsconfig": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
