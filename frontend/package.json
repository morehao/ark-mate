{
  "name": "ark-mate-frontend",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ark-mate/web dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "build:watch": "pnpm --filter @ark-mate/web build:watch",
    "typecheck": "pnpm -r --filter './packages/*' --filter '!./packages/tsconfig' --filter './apps/*' exec tsc --noEmit -p tsconfig.json",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:e2e:live": "node scripts/e2e-live-run.mjs",
    "test:contract": "node --test \"packages/desktop-contract/tests/**/*.test.ts\"",
    "ui:accept": "node scripts/web-ui-acceptance.mjs",
    "ui:accept:desktop": "node scripts/desktop-ui-acceptance.mjs",
    "smoke:desktop": "node scripts/desktop-runtime-smoke.mjs",
    "asset-parity": "node scripts/asset-parity.mjs",
    "verify:engines": "node apps/desktop/scripts/assert-engines.mjs",
    "gen:compliance": "node apps/desktop/scripts/gen-compliance.mjs",
    "verify:compliance": "node apps/desktop/scripts/verify-compliance.mjs",
    "verify:release-json": "node apps/desktop/scripts/verify-release-json.mjs",
    "verify:signature": "node apps/desktop/scripts/verify-signature.mjs",
    "smoke:desktop:packaged": "MATE_SMOKE_APP=apps/desktop/release/mac-arm64/ark-mate.app node scripts/desktop-runtime-smoke.mjs",
    "ui:accept:desktop-skills": "node scripts/desktop-skill-projection-acceptance.mjs",
    "ui:accept:desktop-skills:packaged": "MATE_SMOKE_APP=apps/desktop/release/mac-arm64/ark-mate.app node scripts/desktop-skill-projection-acceptance.mjs",
    "verify:no-host": "node scripts/desktop-no-host-acceptance.mjs",
    "ui:accept:desktop-nohost:packaged": "MATE_SMOKE_APP=apps/desktop/release/mac-arm64/ark-mate.app node scripts/desktop-no-host-acceptance.mjs"
  },
  "devDependencies": {
    "@ark-mate/desktop-contract": "workspace:*"
  }
}
