{
  "name": "ark-forge-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ark/web dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r --filter './packages/*' --filter '!./packages/tsconfig' --filter './apps/*' exec tsc --noEmit -p tsconfig.json",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:e2e:live": "node scripts/e2e-live-turn.mjs",
    "test:contract": "node --test \"packages/desktop-contract/tests/**/*.test.ts\"",
    "ui:accept": "node scripts/web-ui-acceptance.mjs"
  },
  "devDependencies": {
    "@ark/desktop-contract": "workspace:*"
  }
}
