{
  "name": "ark-forge-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ark/panel dev",
    "dev:panel": "pnpm --filter @ark/panel dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "build:panel": "pnpm --filter @ark/panel build",
    "typecheck": "pnpm -r --filter './packages/*' --filter '!./packages/tsconfig' --filter './apps/*' exec tsc --noEmit -p tsconfig.json",
    "typecheck:panel": "pnpm --filter @ark/panel typecheck",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:e2e:live": "node scripts/e2e-live-turn.mjs",
    "ui:accept": "node scripts/panel-ui-acceptance.mjs"
  }
}
